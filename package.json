{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "verify": "pnpm typecheck && pnpm check:assets && pnpm check:content && pnpm build",
    "sync:projects": "node scripts/sync-github-projects.mjs",
    "sync:check": "node scripts/sync-github-projects.mjs --check",
    "freshness": "node scripts/freshness.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.554.0",
    "next": "16.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
